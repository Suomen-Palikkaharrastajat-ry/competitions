cabal-version: 2.2

name:           competition
version:        0.1.0.0
description:    LEGO MOC Competition Platform — gallery pipeline
author:         Suomen Palikkaharrastajat ry
maintainer:     webmaster@palikkaharrastajat.fi
copyright:      2025 Suomen Palikkaharrastajat ry
license:        BSD-3-Clause
build-type:     Simple

library
  exposed-modules:
      Config
      GalleryFetcher
      GalleryGen
      GalleryTypes
      I18n
      HtmlSanitizer
      PocketBase
      Styles
      Scripts
  hs-source-dirs:
      src
  ghc-options: -Wall
  build-depends:
      base >=4.7 && <5
    , text
    , bytestring
    , directory
    , filepath
    , time
    , containers
    , unordered-containers
    , htoml-megaparsec
    , http-conduit
    , http-client
    , http-client-tls
    , blaze-html
    , blaze-markup
    , tagsoup
    , aeson
    , http-types
  default-language: Haskell2010

executable competition
  main-is: Main.hs
  other-modules:
      Config
      GalleryFetcher
      GalleryGen
      GalleryTypes
      I18n
      HtmlSanitizer
      PocketBase
      Styles
      Scripts
  hs-source-dirs:
      src
  ghc-options: -threaded -rtsopts -with-rtsopts=-N -Wall
  build-depends:
      base >=4.7 && <5
    , text
    , bytestring
    , directory
    , filepath
    , time
    , containers
    , unordered-containers
    , htoml-megaparsec
    , http-conduit
    , http-client
    , http-client-tls
    , blaze-html
    , blaze-markup
    , tagsoup
    , aeson
    , http-types
  default-language: Haskell2010

test-suite competition-tests
  type: exitcode-stdio-1.0
  main-is: TestSuite.hs
  other-modules:
      PocketBaseSchemaSpec
      GalleryFetcherSpec
      GalleryGenSpec
  hs-source-dirs:
      tests
  ghc-options: -threaded -rtsopts -with-rtsopts=-N -Wall
  build-depends:
      base >=4.7 && <5
    , text
    , bytestring
    , time
    , containers
    , tagsoup
    , aeson
    , http-conduit
    , http-types
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , competition
  default-language: Haskell2010
