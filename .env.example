# ─── PocketBase ──────────────────────────────────────────────────────────────
# URL of the running PocketBase instance.
# devenv up starts PocketBase at the URL below automatically.
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser API token (≥ 0.22 bearer token).
# Generate: PocketBase admin UI → Settings → API Keys → New API key
POCKETBASE_API_KEY=

# ─── Elm / Vite dev server ───────────────────────────────────────────────────
# Automatically used by Vite; must match POCKETBASE_URL above.
# In elm-app/.env (create separately; gitignored):
#   VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ─── Production only ─────────────────────────────────────────────────────────
# Configure SMTP in PocketBase Admin UI (Settings → Mail) for OTP email delivery.
# Not needed for local dev: pocketbase --dev logs OTP codes to the console.
