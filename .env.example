# ─── PocketBase ──────────────────────────────────────────────────────────────
# URL of the running PocketBase instance.
# devenv up starts PocketBase at the URL below automatically.
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser API token (≥ 0.22 bearer token).
# Generate: PocketBase admin UI → Settings → API Keys → New API key
POCKETBASE_API_KEY=

# ─── Elm / Vite dev server ───────────────────────────────────────────────────
# The Elm app talks to PocketBase through the Caddy proxy on port 8080.
# In elm-app/.env (create separately; gitignored):
#   VITE_POCKETBASE_URL=http://127.0.0.1:8080

# ─── Mailpit (local SMTP) ────────────────────────────────────────────────────
# devenv up starts Mailpit automatically. Run make pb-configure to point PocketBase at it.
# OTP emails appear in the Mailpit web UI at http://127.0.0.1:8025

# ─── Production only ─────────────────────────────────────────────────────────
# Replace mailpit SMTP settings in PocketBase Admin UI (Settings → Mail) with
# real SMTP credentials before deploying to production.
